IMAGE_TAG=1.0.26
WEB_IMAGE_TAG=1.0.34
WORKER_IMAGE_TAG=1.0.34
SIGNER_IMAGE_TAG=1.0.34

APP_PORT=8081
SIGNER_PORT=5000
APP_BASE_URL=http://localhost:8081
PYTHON_SERVICE_PUBLIC_URL=http://localhost:5000
PHP_UPLOAD_MAX_FILESIZE=1024M
PHP_POST_MAX_SIZE=1024M
PHP_MAX_FILE_UPLOADS=100
PHP_MEMORY_LIMIT=512M
PHP_MAX_EXECUTION_TIME=1200
PHP_MAX_INPUT_TIME=1200
PHP_MAX_INPUT_VARS=5000
PHP_DATE_TIMEZONE=America/Sao_Paulo
PHP_DISPLAY_ERRORS=Off
PHP_LOG_ERRORS=On
GED_ENABLE_INLINE_OCR=0
GED_ENABLE_SYNC_R2_UPLOAD=1
RUNTIME_CLEANUP_ENABLED=true
RUNTIME_CLEANUP_INTERVAL=21600
RUNTIME_CLEANUP_LOG_RETENTION_DAYS=7
RUNTIME_CLEANUP_TMP_RETENTION_DAYS=7
RUNTIME_CLEANUP_CACHE_RETENTION_DAYS=7
RUNTIME_CLEANUP_DRY_RUN=false

DB_SERVER=host.docker.internal
DB_SERVER_PORT=3306
DB_SERVER_USERNAME=root
DB_SERVER_PASSWORD=
DB_DATABASE=infodoc_sisged

DB_HOST=host.docker.internal
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=infodoc_sisged

SIGNER_SECRET_KEY=troque-esta-chave-docker
TOKEN_EXPIRY=3600

# Cloudflare R2 / S3 compativel
FILE_STORAGE_R2_ENDPOINT=
FILE_STORAGE_R2_REGION=auto
FILE_STORAGE_R2_BUCKET=
FILE_STORAGE_R2_ACCESS_KEY_ID=
FILE_STORAGE_R2_SECRET_ACCESS_KEY=
FILE_STORAGE_R2_OBJECT_PREFIX=
FILE_STORAGE_CRON_INTERVAL=60

# IMAGE_TAG continua como fallback global.
# Se precisar publicar apenas um servico em uma nova versao,
# sobrescreva WEB_IMAGE_TAG, WORKER_IMAGE_TAG e/ou SIGNER_IMAGE_TAG.