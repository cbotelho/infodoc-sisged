IMAGE_TAG=1.0.0

# Caminho no servidor para sua estrutura Tenant/Setor/Caixa
SERVER_FILES_ROOT=/opt/infodoc-agent/data
AGENT_ROOT_PATH=/data
AGENT_POLL_INTERVAL_SECONDS=30
AGENT_TENANT_ALLOWLIST=
AGENT_DRY_RUN=false
AGENT_API_PORT=18090
AGENT_DB_PATH=/data/.agent/queue.db
AGENT_BATCH_SIZE=50
AGENT_MAX_ATTEMPTS=5
AGENT_BACKOFF_BASE_SECONDS=30
AGENT_BACKOFF_MAX_SECONDS=1800

# S3/R2
S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=<access-key>
S3_SECRET_ACCESS_KEY=<secret-key>

# Se informado, bucket final vira: <prefix>-<tenant>
S3_BUCKET_PREFIX=infodoc
